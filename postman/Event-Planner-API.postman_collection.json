{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Event Planner API",
    "description": "REST collection for the Event Planner assessment API (`/api/v1`).\n\n1. Set `baseUrl` (default `http://localhost:9000`).\n2. Run **Auth → Sign up** then **Verify email** (use `testOtp` from the signup response in non-production).\n3. Run **Login** — tokens are saved to `accessToken` / `refreshToken` automatically.\n4. Use Events / Meta / 2FA folders with the bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "email", "value": "demo@example.com" },
    { "key": "password", "value": "password123" },
    { "key": "name", "value": "Demo User" },
    { "key": "otp", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "totpCode", "value": "" },
    { "key": "backupCode", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const data = body.data || {};",
                  "  if (data.email) pm.collectionVariables.set('email', data.email);",
                  "  if (data.testOtp) pm.collectionVariables.set('otp', data.testOtp);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/signup"
          }
        },
        {
          "name": "Verify email",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"code\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/verify-email"
          }
        },
        {
          "name": "Resend OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || {};",
                  "  if (data.testOtp) pm.collectionVariables.set('otp', data.testOtp);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/resend-otp"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || {};",
                  "  if (data.token) pm.collectionVariables.set('accessToken', data.token);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "  if (data.userId) pm.collectionVariables.set('userId', data.userId);",
                  "  if (data.testOtp) pm.collectionVariables.set('otp', data.testOtp);",
                  "  if (data.user && data.user.id) pm.collectionVariables.set('userId', data.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Complete 2FA login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || {};",
                  "  if (data.token) pm.collectionVariables.set('accessToken', data.token);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"code\": \"{{totpCode}}\",\n  \"backup\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/2fa/session",
            "description": "Use after login returns `requires2FA`. Set `totpCode`, or set `backup: true` and use a backup code in `code`."
          }
        },
        {
          "name": "Refresh tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || {};",
                  "  if (data.token) pm.collectionVariables.set('accessToken', data.token);",
                  "  if (data.refreshToken) pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{name}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 204 || pm.response.code === 200) {",
                  "  pm.collectionVariables.set('accessToken', '');",
                  "  pm.collectionVariables.set('refreshToken', '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "2FA",
      "item": [
        {
          "name": "2FA status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/2fa/status"
          }
        },
        {
          "name": "2FA setup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/2fa/setup",
            "description": "Returns `qrDataUrl` and `secret`. Scan with an authenticator, then call Verify."
          }
        },
        {
          "name": "2FA verify (enable)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data || {};",
                  "  if (data.backupCodes && data.backupCodes[0]) {",
                  "    pm.collectionVariables.set('backupCode', data.backupCodes[0]);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{totpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/2fa/verify"
          }
        },
        {
          "name": "2FA disable",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{totpCode}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/2fa/disable",
            "description": "Pass a TOTP code or a backup code in `token`."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "List events",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events?page=1&pageSize=8&period=all&visibility=all&sort=date-asc&search=&tag=&mine=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "8" },
                { "key": "period", "value": "all", "description": "all | upcoming | past" },
                { "key": "visibility", "value": "all", "description": "all | public | private | invite" },
                { "key": "sort", "value": "date-asc", "description": "date-asc | date-desc | newest" },
                { "key": "search", "value": "", "description": "Title or location" },
                { "key": "tag", "value": "" },
                { "key": "mine", "value": "false" }
              ]
            }
          }
        },
        {
          "name": "Create event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json().data || {};",
                  "  if (data.id) pm.collectionVariables.set('eventId', data.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Team standup\",\n  \"description\": \"Weekly sync for the product team.\",\n  \"startsAt\": \"2026-12-01T09:00:00+05:45\",\n  \"endsAt\": null,\n  \"location\": \"Kathmandu\",\n  \"visibility\": \"public\",\n  \"tags\": [\"work\", \"meeting\"],\n  \"inviteEmails\": []\n}"
            },
            "url": "{{baseUrl}}/api/v1/events"
          }
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          }
        },
        {
          "name": "Update event",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Team standup (updated)\",\n  \"location\": \"Pokhara\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          }
        },
        {
          "name": "RSVP",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"yes\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}/rsvp",
            "description": "`status`: yes | no | maybe"
          }
        },
        {
          "name": "Delete event",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/events/{{eventId}}"
          }
        }
      ]
    },
    {
      "name": "Meta",
      "item": [
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/dashboard"
          }
        },
        {
          "name": "Tags",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/tags"
          }
        }
      ]
    },
    {
      "name": "Docs",
      "item": [
        {
          "name": "OpenAPI JSON",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/api/openapi.json"
          }
        }
      ]
    }
  ]
}
